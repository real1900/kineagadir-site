{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kineagadir-site",
  "compatibility_date": "2026-05-20",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "www.kineagadir.com", "custom_domain": true },
    { "pattern": "kineagadir.com", "custom_domain": true }
  ]
}
